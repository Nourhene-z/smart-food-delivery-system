# Smart Food Delivery System - Environment Variables
# Copy this file to .env and update values for your environment

# Application Settings
APP_NAME=smart-food-delivery-system
APP_VERSION=1.0.0
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/food_delivery_db?createDatabaseIfNotExist=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=apppass
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_TIMEOUT=60000
SPRING_REDIS_LETTUCE_POOL_MAX_ACTIVE=8
SPRING_REDIS_LETTUCE_POOL_MAX_IDLE=8
SPRING_REDIS_LETTUCE_POOL_MIN_IDLE=0

# Cache Configuration
SPRING_CACHE_TYPE=redis
SPRING_CACHE_REDIS_TIME_TO_LIVE=3600000

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_DESIGNPATTERNS_FOODDELIVERY=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_FILE_NAME=logs/application.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=30

# Resilience4j Circuit Breaker
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_GPSSERVICECIRCUITBREAKER_SLIDING_WINDOW_SIZE=100
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_GPSSERVICECIRCUITBREAKER_MINIMUM_NUMBER_OF_CALLS=5
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_GPSSERVICECIRCUITBREAKER_FAILURE_RATE_THRESHOLD=50
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_GPSSERVICECIRCUITBREAKER_WAIT_DURATION_IN_OPEN_STATE=30000

# Resilience4j Retry
RESILIENCE4J_RETRY_INSTANCES_DELIVERYTRACKINGRETRY_MAX_ATTEMPTS=3
RESILIENCE4J_RETRY_INSTANCES_DELIVERYTRACKINGRETRY_WAIT_DURATION=2000

# Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,prometheus,info,circuitbreakers,retries,caches
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_ENDPOINT_HEALTH_SHOW_COMPONENTS=always

# External Services
GPS_SERVICE_URL=http://localhost:8081/api/gps
PAYMENT_GATEWAY_URL=http://localhost:8082/api/payment
NOTIFICATION_SERVICE_URL=http://localhost:8083/api/notification

# Email Configuration (for notifications)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# JWT Configuration (for future security implementation)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_SERVLET_CONTEXT_PATH=/
SERVER_ERROR_INCLUDE_MESSAGE=always
SERVER_ERROR_INCLUDE_STACKTRACE=on-param

# Feature Flags
FEATURE_PAYMENT_ENABLED=true
FEATURE_DELIVERY_ENABLED=true
FEATURE_NOTIFICATION_ENABLED=true
FEATURE_CACHING_ENABLED=true
FEATURE_CIRCUIT_BREAKER_ENABLED=true

# Docker Configuration
DOCKER_MYSQL_VERSION=8.0
DOCKER_REDIS_VERSION=7-alpine
DOCKER_APP_IMAGE=smart-food-delivery-system:1.0.0

# Performance Tuning
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=10
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_INSERTS=true
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_UPDATES=true

# Development Settings
DEBUG=false
ENABLE_MOCK_SERVICES=true
MOCK_GPS_FAILURE_RATE=10
MOCK_PAYMENT_FAILURE_RATE=3
MOCK_NOTIFICATION_FAILURE_RATE=2

# Notes
# - Change passwords before deploying to production
# - Use environment-specific files for prod/staging
# - Keep sensitive values in separate secrets management system
# - Review security implications of each setting
